{
  "permission": {
    "*": "ask",

    "read": "allow",
    "grep": "allow",
    "find": "allow",
    "ls": "allow",
    "write": "allow",
    "edit": "allow",
    "web_search": "allow",
    "fetch_content": "allow",

    "bash": {
      "*": "ask",

      "echo *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "ls *": "allow",
      "grep *": "allow",
      "egrep *": "allow",
      "fgrep *": "allow",
      "find *": "allow",
      "wc *": "allow",
      "du *": "allow",
      "df *": "allow",
      "stat *": "allow",
      "file *": "allow",
      "diff *": "allow",
      "which *": "allow",
      "type *": "allow",
      "pwd *": "allow",
      "date *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "cut *": "allow",
      "ps *": "allow",
      "test *": "allow",
      "sed -n *": "allow",
      "cd *": "allow",

      "go build *": "allow",
      "go test *": "allow",
      "go vet *": "allow",
      "go list *": "allow",
      "go get *": "allow",
      "go mod tidy *": "allow",
      "gofmt -l *": "allow",

      "git add *": "allow",
      "git commit *": "allow",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git blame *": "allow",
      "git ls-files *": "allow",
      "git branch": "allow",
      "git branch -a *": "allow",
      "git branch --show-current *": "allow",
      "git remote -v *": "allow",
      "git remote show *": "allow",
      "git fetch *": "allow",
      "git checkout *": "allow",
      "git switch *": "allow",
      "git ls-remote *": "allow",
      "git tag -l *": "allow",
      "git tag --list *": "allow",
      "git describe *": "allow",
      "git reflog *": "allow",
      "git version *": "allow",

      "gh auth status *": "allow",
      "gh pr view *": "allow",
      "gh pr list *": "allow",
      "gh pr checks *": "allow",
      "gh pr diff *": "allow",
      "gh run view *": "allow",
      "gh run list *": "allow",
      "gh repo view *": "allow",
      "pi install *": "allow",
      "pi uninstall *": "allow",
      "gh pr create *": "allow"
    },
    "external_directory_read": {
      "*": "allow"
    },
    "external_directory_write": {
      "*": "ask",
      "/tmp/*": "allow"
    }
  }
}
